# Server configuration
PORT=4173
HOST=0.0.0.0

# Supabase project URL. Used by the backend client.
SUPABASE_URL=https://your-project-ref.supabase.co

# Private backend-only credential. Never expose this value to the browser.
# Prefer a secret/service role key only in trusted server environments.
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Optional public client values for a future frontend Supabase integration.
# These are publishable credentials, but database access must still be protected
# with correctly configured Row Level Security policies.
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

